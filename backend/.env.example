# Salin ke backend/.env untuk dev. Jangan commit file .env.
GIN_MODE=debug
# Folder openapi.yaml dan Swagger UI, hanya dipakai saat GIN_MODE=debug (/api/docs)
DOCS_DIR=../docs
HTTP_ADDR=127.0.0.1:8082

# Role compro_app (DML saja), lewat SSH tunnel scripts/dev-db-tunnel.sh
DATABASE_URL=postgres://compro_app:GANTI_PASSWORD@127.0.0.1:15432/nvm_compro?sslmode=disable

PUBLIC_BASE_URL=http://127.0.0.1:5175
BRAND_EST_YEAR=2021
MEDIA_DIR=var/media

# Isi dengan nilai acak panjang, contoh hasil: openssl rand -hex 32
IP_HASH_SALT=

# true hanya bila situs diakses lewat HTTPS
COOKIE_SECURE=false

# CIDR proxy yang boleh mengisi X-Forwarded-For. Kosong di dev.
TRUSTED_PROXIES=
