# Salin ke deploy/.env di VM. Jangan commit file .env.

# Jaringan Docker dan nama container Postgres yang sudah ada.
# Cek dengan: docker ps, lalu docker inspect <container>
PG_NETWORK=
PG_CONTAINER=

# Role compro_app (DML saja). Password yang mengandung karakter khusus harus di-URL-encode.
DATABASE_URL=postgres://compro_app:GANTI_PASSWORD@NAMA_CONTAINER_POSTGRES:5432/nvm_compro?sslmode=disable

# Isi dengan nilai acak panjang, contoh hasil: openssl rand -hex 32
IP_HASH_SALT=

# Alamat yang dibuka pengunjung, dipakai sitemap dan robots
PUBLIC_BASE_URL=http://192.168.68.144:8092
BRAND_EST_YEAR=2021

# Tetap false selama akses lewat HTTP LAN. Kalau true, browser menolak cookie login.
COOKIE_SECURE=false

# Ganti hanya bila bentrok dengan jaringan Docker lain di VM
COMPRO_SUBNET=172.30.92.0/24

# Kosong berarti link tidak tampil di situs. Perubahan butuh build ulang frontend.
VITE_SHOPEE_URL=
VITE_TIKTOK_SHOP_URL=
VITE_INSTAGRAM_URL=

# Hanya untuk deploy/backup.sh
BACKUP_DIR=/srv/nvm-compro/backup
PGPASSWORD_MIGRATOR=
